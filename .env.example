# Meta Model API (https://dev.meta.ai -> API keys)
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Model IDs (verify with GET /v1/models)
REASONING_MODEL=muse-spark-1.3
REASONING_MODEL_EVAL=muse-spark-1.3-contributor   # staged rig data only, see SECURITY.md
SEGMENTATION_MODEL=sam-3.1
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
IMAGE_MODEL=muse-image-1.0

# Open weights via Baseten (optional)
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Fireworks (stretch: fine-tuned observation model)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_BASE_MODEL=        # Muse open-weight model id, set from the Fireworks docs / Oct 30 session
FIREWORKS_TUNED_MODEL=       # filled in after the fine-tuning job finishes

# App
DATABASE_URL=sqlite:///./data/fixvision.db
MEDIA_DIR=./data/raw
MEDIA_RETENTION_DAYS=7
SAM_SAMPLE_FPS=10
DAILY_SPEND_LIMIT_USD=15
